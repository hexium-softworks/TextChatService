{
  "Service": {
    "prefix": "/nservice",
    "description": "Create a canonical Nevermore service",
    "body": [
      "--[=[",
      "\t${2:A canonical service in Nevermore}",
      "\t@class ${1:${TM_FILENAME_BASE:ServiceName}}",
      "]=]",
      "",
      "local require = require(script.Parent.loader).load(script)",
      "",
      "local Maid = require(\"Maid\")",
      "",
      "local ${1:${TM_FILENAME_BASE:ServiceName}} = {}",
      "${1:${TM_FILENAME_BASE:ServiceName}}.ServiceName = \"${1:${TM_FILENAME_BASE:ServiceName}}\"",
      "",
      "function ${1:${TM_FILENAME_BASE:ServiceName}}:Init(serviceBag)",
      "\tassert(not self._serviceBag, \"Already initialized\")",
      "\tself._serviceBag = assert(serviceBag, \"No serviceBag\")",
      "\tself._maid = Maid.new()",
      "",
      "\t-- External",
      "\tself._serviceBag:GetService(require(\"${3:OtherService}\"))",
      "end",
      "",
      "function ${1:${TM_FILENAME_BASE:ServiceName}}:Start()",
      "\tprint(\"Started\")",
      "end",
      "",
      "function ${1:${TM_FILENAME_BASE:ServiceName}}:${4:MyMethod}()",
      "\t$0",
      "end",
      "",
      "function ${1:${TM_FILENAME_BASE:ServiceName}}:Destroy()",
      "\tself._maid:DoCleaning()",
      "end",
      "",
      "return ${1:${TM_FILENAME_BASE:ServiceName}}",
    ],
  },
  "Object": {
    "prefix": "/nobject",
    "description": "Create a Nevermore BaseObject-derived class",
    "body": [
      "--[=[",
      "\t@class ${1:${TM_FILENAME_BASE:MyClass}}",
      "]=]",
      "",
      "local require = require(script.Parent.loader).load(script)",
      "",
      "local BaseObject = require(\"BaseObject\")",
      "",
      "local ${1:${TM_FILENAME_BASE:MyClass}} = setmetatable({}, BaseObject)",
      "${1:${TM_FILENAME_BASE:MyClass}}.ClassName = \"${1:${TM_FILENAME_BASE:MyClass}}\"",
      "${1:${TM_FILENAME_BASE:MyClass}}.__index = ${1:${TM_FILENAME_BASE:MyClass}}",
      "",
      "function ${1:${TM_FILENAME_BASE:MyClass}}.new(serviceBag)",
      "\tlocal self = setmetatable(BaseObject.new(), ${1:${TM_FILENAME_BASE:MyClass}})",
      "",
      "\tself._serviceBag = assert(serviceBag, \"No serviceBag\")",
      "\tself._${2:cameraStackService} = self._serviceBag:GetService(require(\"${3:CameraStackService}\"))",
      "",
      "\t$0",
      "",
      "\treturn self",
      "end",
      "",
      "return ${1:${TM_FILENAME_BASE:MyClass}}",
    ],
  },
  "Constants": {
    "prefix": "/nconstants",
    "description": "Create a Nevermore constants module",
    "body": [
      "--!strict",
      "--[=[",
      "\t${2:Constants for the system}",
      "\t@class ${1:${TM_FILENAME_BASE:Constants}}",
      "]=]",
      "",
      "local require = require(script.Parent.loader).load(script)",
      "",
      "local Table = require(\"Table\")",
      "",
      "export type ${1:${TM_FILENAME_BASE:Constants}} = {${3}}",
      "",
      "return Table.readonly({${0}} :: ${1:${TM_FILENAME_BASE:Constants}})",
    ],
  },
}
